# Sender Information
SENDER_NAME=Your Full Name
SENDER_EMAIL=your_email@gmail.com

# For Gmail, generate a 16-character App Password at:
# https://myaccount.google.com/apppasswords
SENDER_PASSWORD=your_16_char_app_password_here

# SMTP Server Settings (Defaults for Gmail)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_SSL=true

# File Paths (Excel list and Resume PDF in this folder)
EXCEL_FILE=recipients.xlsx
ATTACHMENT_FILE=resume.pdf
ATTACHMENT_DISPLAY_NAME=Resume.pdf

# Anti-Spam Safety Throttling (Random delay in seconds between emails)
DELAY_MIN=5
DELAY_MAX=10

# Logging
LOG_FILE=sent_log.csv
